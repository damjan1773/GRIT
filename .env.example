# Kopiraj u .env i upiši svoj ključ. .env se ne commituje.
# Ključ se ugrađuje u aplikaciju pri build-u, pa ga mogu izvući svi koji dobiju aplikaciju.
# Za ličnu upotrebu je u redu; pre deljenja aplikacije poziv treba da ide preko servera.

# mock = nasumične vrednosti bez mreže, gemini = pravi model
EXPO_PUBLIC_MEAL_PARSER_PROVIDER=gemini
EXPO_PUBLIC_MEAL_PARSER_MODEL=gemini-3.6-flash
EXPO_PUBLIC_MEAL_PARSER_API_KEY=
