{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nutra-expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web"],
      "port": 8081
    },
    {
      "name": "nutra-expo-web-check",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8090"],
      "port": 8090
    },
    {
      "name": "nutra-web-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "-s", "dist", "-l", "8091"],
      "port": 8091
    }
  ]
}
